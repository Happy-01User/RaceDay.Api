@model RaceDay.Contracts.CreateEventRequest
@{
    ViewData["Title"] = "Create Event";
}

<h2>Create Event</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="EventType" class="form-label"></label>
        <input asp-for="EventType" class="form-control" placeholder="e.g. 5K Run, Marathon, Cycle" />
    </div>

    <button type="submit" class="btn btn-primary">Create Event</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>